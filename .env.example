# Database connection string for PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/medgenz"

# NextAuth secret (generate a random string)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin Credentials (used for manual DB seed)
ADMIN_EMAIL="admin@medgenz.com"
ADMIN_PASSWORD="secure-password-123"

# Contact form SMTP settings (use the mailbox provider's SMTP details)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER="info@medgenz.com"
SMTP_PASS=""
CONTACT_RECEIVER="info@medgenz.com"

# Optional auto-reply overrides. A branded MedGenz confirmation is used by default.
# Supported placeholders: {{name}}, {{email}}, {{phone}}, {{subject}}, {{designation}}, {{message}}
CONTACT_AUTOREPLY_SUBJECT=""
CONTACT_AUTOREPLY_TEXT=""
